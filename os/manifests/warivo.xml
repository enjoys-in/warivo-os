<?xml version="1.0" encoding="UTF-8"?>
<!--
  Warivo OS — repo local manifest.

  Copy to .repo/local_manifests/warivo.xml inside a synced LineageOS tree, then re-run
  `repo sync`, to pull the extra sources a build needs.

  A Treble GSI build needs NOTHING from this file: it uses the phone's own kernel and
  vendor partition, and Warivo's own trees are copied in from os/ by
  os/build/build-rom.sh. Everything here is for a full device port.

  Nothing below is filled in, because every entry is specific to the phone that has not
  been chosen yet (see docs/ROM_BUILD.md §3). Taking these from the LineageOS device tree
  for that exact model is the whole job; guessing them produces a build that completes and
  then does not boot.
-->
<manifest>

  <remote name="los" fetch="https://github.com/LineageOS/" revision="refs/heads/lineage-21.0" />

  <!-- Device tree: the board config, partition layout and fstab for the phone.
       <project name="android_device_<oem>_<codename>"
                path="device/<oem>/<codename>"
                remote="los" />
  -->

  <!-- Kernel source. os/kernel/configs/warivo.fragment is merged on top of its defconfig;
       see os/kernel/README.md.
       <project name="android_kernel_<oem>_<soc>"
                path="kernel/<oem>/<soc>"
                remote="los" />
  -->

  <!-- Vendor blobs: the proprietary bits (modem, camera, GPU firmware) that cannot be
       built from source and must be extracted from the phone or a stock image.
       <project name="proprietary_vendor_<oem>"
                path="vendor/<oem>"
                remote="los" />
  -->

</manifest>
